{
  "manifest_version": 3,
  "name": "DSH Browser",
  "version": "0.1.1",
  "description": "Connect DeepSeek Harness to this Chrome browser.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "activeTab",
    "alarms",
    "storage",
    "tabGroups",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[::1]:*/*"
    ]
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_title": "DSH Browser",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  }
}
