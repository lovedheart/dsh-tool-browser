{
  "name": "dsh-tool-browser",
  "description": "Model-facing browser automation tool (browser) for DeepSeek Harness: drive a live Playwright/Chrome browser by writing async JavaScript against a stateful Browser SDK, ported from QwenPaw's Unified Browser SDK.",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node test/run-e2e.mjs",
    "test:offline": "E2E_OFFLINE=1 node test/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "setup:peers": "bash setup-peers.sh",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "playwright": "^1.49.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0"
  }
}
